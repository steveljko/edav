# Caddy obtains and renews the certificate on its own, so there is no certbot
# to run and nothing to remember to renew.
#
# Replace the domain, and the email Let's Encrypt uses to warn about expiry.
dav.example.com {
	encode zstd gzip

	# Everything goes to edav, the well-known paths included. Those must be
	# served from the root of the domain and must not require authentication:
	# iOS and macOS probe them before they have credentials to send, and a 401
	# there ends discovery with no useful error shown to the user. edav answers
	# them itself, so forwarding the whole domain is all that is needed.
	reverse_proxy edav:8080 {
		# A sync of a large collection takes longer than a page load.
		transport http {
			read_timeout 300s
		}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
