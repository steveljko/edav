# Copy to edav.env beside docker-compose.yml and fill in. Not committed.
#
#   cp deploy/edav.env.example edav.env
#   chmod 600 edav.env
#
# Generate a password rather than inventing one:
#
#   openssl rand -base64 24
#
# This seeds the admin account on first start only. Changing it afterwards has
# no effect; change the password in the admin interface instead.
EDAV_ADMIN_PASSWORD=
